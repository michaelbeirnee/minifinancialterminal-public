# Copy to .env and edit. Nothing here is required — the platform runs fully
# unconfigured — but setting the paths keeps every entry point on one database.

# The one shared data directory: Docker bind-mounts it at /data, while run.sh and
# the CLI read it directly, so all four interfaces see the same accounts and cache.
# Without this, Docker uses its own volume and host runs use ./terminal.db, and the
# two silently diverge.
MFT_DATA_DIR=$HOME/.5milliondollars

# Host-side runs read these. The container ignores them — docker-compose.yml pins
# the container-side paths to the /data mount. Use absolute paths (note: the
# sqlite:// scheme plus a leading / on the path means four slashes).
MFT_DATABASE_URL=sqlite:////absolute/path/to/.5milliondollars/terminal.db
MFT_CACHE_DIR=/absolute/path/to/.5milliondollars/cache

# Signs login tokens. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Required once MFT_DEBUG=false — the app refuses to boot on the shipped default,
# because anyone holding it can mint a token for any account.
# MFT_SECRET_KEY=

# --- Deployment ---------------------------------------------------------
# Leave unset (defaults to true) for local work. Set false on any host that is
# reachable from the internet; that is what arms the secret-key check above.
# MFT_DEBUG=false

# Closes POST /api/auth/register. Open sign-up on a public host hands strangers
# the Assistant tab, which spends your Anthropic credits. Register your own
# account first, then set this to false.
# MFT_ALLOW_REGISTRATION=false

# Comma-separated browser origins allowed to call the API cross-origin. Empty
# (the default) means same-origin only, which is right when one process serves
# both the UI and the API. Only needed if the frontend moves to its own host:
#   MFT_CORS_ORIGINS=https://michaelbeirnee.github.io
# MFT_CORS_ORIGINS=

# SEC EDGAR blocks automated clients that do not identify themselves, and the
# built-in default is a placeholder address. Set a real contact before any
# deployment leans on SEC data.
# MFT_SEC_USER_AGENT=Mini Financial Terminal you@example.com

# Hours between signal-grading sweeps, which stamp realised outcomes onto
# recorded signals once their horizons elapse. Set to 0 to switch the clock off
# and grade by hand via POST /api/theses/signals/grade.
# MFT_GRADING_INTERVAL_HOURS=12

# Optional free API keys — every command that uses one has a key-free fallback.
# MFT_ANTHROPIC_API_KEY=   # Assistant tab + thesis triage (the only paid dependency)
# MFT_FRED_API_KEY=
# MFT_EIA_API_KEY=
# MFT_BLS_API_KEY=
# MFT_NASDAQ_API_KEY=

# Live prices stream from Yahoo's public feed with no key at all. Alpaca is the
# optional second source: a free app key (no funded account needed) adds
# licensed trades and bid/ask over the IEX feed — and the same keys let paper
# trading route orders to your Alpaca *paper* account (the code refuses any
# endpoint but paper-api.alpaca.markets). https://alpaca.markets
# MFT_ALPACA_API_KEY=
# MFT_ALPACA_API_SECRET=
# MFT_ALPACA_FEED=iex                 # iex (free) | sip (paid) | delayed_sip | test
# MFT_STREAM_DEFAULT_PROVIDER=yahoo   # or alpaca, once its keys are set

# The Python playground executes arbitrary code as the server user — the point
# on your own machine, a liability on a public host. Unset, it follows
# MFT_DEBUG: on locally, off on a deployment. Set true only deliberately.
# MFT_PLAYGROUND_ENABLED=true
# MFT_PLAYGROUND_TIMEOUT_SECONDS=120

# The tick recorder writes every live print it sees to Parquet under
# MFT_TICK_STORE_DIR (default ./tick_store — not the clearable cache). Name
# symbols here to start recording at boot; otherwise drive it from the UI.
# MFT_RECORD_SYMBOLS=SPY,QQQ,BTC-USD,EURUSD=X
# MFT_TICK_STORE_DIR=/absolute/path/to/tick_store
